{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "go: build",
            "type": "shell",
            "command": "go",
            "args": [
                "build",
                "-o",
                "${workspaceFolder}/bin/go_api",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$go"
        },
        {
            "label": "go: vet",
            "type": "shell",
            "command": "go",
            "args": ["vet", "./..."],
            "group": "test",
            "problemMatcher": "$go"
        }
    ]
}
