{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "maven: build",
            "command": "mvn",
            "args": ["clean", "package", "-DskipTests"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "maven: compile",
            "command": "mvn",
            "args": ["compile", "-o", "-q"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "spring-boot: run (debug)",
            "command": "mvn",
            "args": [
                "spring-boot:run",
                "-Dspring-boot.run.jvmArguments=-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=*:5005"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": "^\\[ERROR\\]\\s+(.*):\\[(\\d+),(\\d+)\\]\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "message": 4
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Scanning for projects",
                    "endsPattern": "Listening for transport dt_socket at address"
                }
            }
        }
    ]
}
